{
	"name": "monorepo-template-root",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"build:doc": "pnpm --filter=./apps/page sb:build",
		"check": "biome check --write",
		"check:ci": "biome ci",
		"clean": "turbo run clean",
		"coverage": "turbo run coverage",
		"cs": "changeset",
		"knip": "knip",
		"nl": "pnpm --filter=./packages/node-library",
		"nuke": "turbo run nuke && pnpm nuke:root",
		"nuke:root": "rimraf node_modules",
		"prepare": "node -e \"if(!(process.env.CI||process.env.GITHUB_ACTIONS))require('child_process').execSync('husky',{stdio:'inherit'})\"",
		"release": "changeset publish",
		"size": "turbo run size",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "run-p check:ci knip verify:p",
		"verify:p": "turbo run build typecheck coverage size",
		"version": "changeset version"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@changesets/cli": "^3.0.1",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@repobuddy/biome": "2.3.1",
		"husky": "^9.1.7",
		"knip": "^6.32.2",
		"npm-run-all2": "^9.0.3",
		"playwright": "^1.62.1",
		"rimraf": "~6.1.3",
		"turbo": "^2.10.11",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@11.25.0"
}
