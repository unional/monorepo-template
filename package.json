{
	"private": true,
	"license": "MIT",
	"scripts": {
		"build": "turbo run build",
		"build:doc": "pnpm --filter=./apps/page sb:build",
		"clean": "turbo run clean",
		"check": "run-p check:*",
		"check:biome": "biome check",
		"coverage": "turbo run coverage",
		"cs": "changeset",
		"knip": "knip",
		"fix": "biome check --write",
		"nl": "pnpm --filter=./packages/node-library",
		"nuke": "turbo run nuke && pnpm nuke:root",
		"nuke:root": "rimraf node_modules",
		"prepare": "husky",
		"release": "changeset publish",
		"size": "turbo run size",
		"test": "turbo run test",
		"verify": "run-p check knip verify:p",
		"verify:p": "turbo run build coverage size",
		"version": "changeset version"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.0.0",
		"@commitlint/config-conventional": "^21.0.0",
		"@repobuddy/biome": "2.3.1",
		"husky": "^9.1.7",
		"knip": "^6.0.0",
		"npm-run-all2": "^9.0.0",
		"playwright": "^1.58.0",
		"rimraf": "~6.1.0",
		"turbo": "^2.5.1",
		"typescript": "^7.0.0"
	},
	"packageManager": "pnpm@11.24.0"
}
