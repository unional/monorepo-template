{
	"name": "node-library",
	"version": "0.0.0",
	"private": true,
	"description": "Your awesome node library",
	"keywords": [],
	"homepage": "https://github.com/repobuddy/monorepo-template",
	"bugs": {
		"url": "https://github.com/repobuddy/monorepo-template/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/repobuddy/monorepo-template.git",
		"directory": "packages/node-library"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com",
		"url": "https://github.com/unional"
	},
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#node-library": "./src/index.ts"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"!**/*.{spec,test,unit,accept,integrate,system,perf,stress,study,stories}.*"
	],
	"scripts": {
		"build": "tsdown",
		"clean": "rimraf dist cjs esm coverage lib --glob *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"nuke": "rimraf node_modules",
		"sb": "storybook dev -p 6006",
		"sb:build": "storybook build",
		"size": "size-limit",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"w": "run-p w:build w:test",
		"w:build": "tsc -w",
		"w:test": "vitest"
	},
	"devDependencies": {
		"@repobuddy/typescript": "^2.1.0",
		"@repobuddy/vitest": "^2.1.2",
		"@size-limit/preset-small-lib": "~13.0.3",
		"@storybook/addon-a11y": "^10.5.10",
		"@storybook/addon-docs": "^10.5.10",
		"@storybook/addon-vitest": "^10.5.10",
		"@storybook/react-vite": "^10.5.10",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitest/browser": "^5.0.0",
		"@vitest/browser-playwright": "^5.0.0",
		"@vitest/coverage-v8": "^5.0.0",
		"npm-run-all2": "^9.0.3",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"rimraf": "~6.1.3",
		"size-limit": "~13.0.3",
		"storybook": "^10.5.10",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	}
}
